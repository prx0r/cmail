{
  "id": "target:youtube",
  "name": "YouTube",
  "category": "social",
  "platform": "google",
  "autonomy": "agent_guaranteed",
  "requires_human": false,
  "captcha_risk": "medium",
  "note": "YouTube channel creation via Google account. Google may require phone verification.",
  "cost": {
    "min": 0,
    "max": 0,
    "currency": "USD",
    "period": "month",
    "free_variant": true,
    "note": "Free. YouTube Data API has 10,000 unit/day quota."
  },
  "depends_on": [
    "target:email",
    "target:phone"
  ],
  "capabilities_required": [
    "receive_email",
    "can_verify_phone"
  ],
  "capabilities_granted": [
    "have_handle:youtube",
    "have_google_account"
  ],
  "stack": {
    "provider": "google",
    "apis": {
      "youtube": "YouTube Data API v3",
      "accounts": "Google Accounts (no public API \u2014 Playwright)"
    },
    "auth": "Google OAuth 2.0 (from account creation)",
    "docs": [
      "https://developers.google.com/youtube/v3",
      "https://developers.google.com/youtube/create-channel"
    ]
  },
  "tasks": [
    {
      "id": "task:signup_google",
      "type": "agent_or_human",
      "method": "playwright",
      "captcha": true,
      "captcha_action": "ESCALATE_TO_HUMAN",
      "browser_action": {
        "url": "https://accounts.google.com/signup",
        "steps": [
          "fill first_name + last_name",
          "fill username: {handle} or agents@{domain}",
          "fill password: {generated_password}",
          "phone verification: USE TELNYX SMS",
          "accept terms"
        ]
      },
      "verification": {
        "method": "email + sms",
        "email_inbox": "agents@{domain}",
        "sms_number": "{phone_number}",
        "sms_provider": "telnyx"
      },
      "on_captcha": {
        "action": "pause_and_notify_human",
        "message": "Google signup has a captcha. Please complete this step manually.",
        "url": "https://accounts.google.com/signup"
      }
    },
    {
      "id": "task:create_youtube_channel",
      "type": "agent",
      "depends_on": [
        "task:signup_google"
      ],
      "method": "api",
      "api_call": {
        "service": "YouTube Data API v3",
        "method": "POST /youtube/v3/channels?part=snippet",
        "note": "Channel created on first upload or via youtubeSignupRequired error flow"
      }
    }
  ],
  "gates": [
    "google_account_created_v1",
    "channel_created_v1",
    "handle_owned_v1"
  ],
  "escalation_rules": {
    "if_captcha": "pause_and_notify_human",
    "if_phone_verify_required": "use_telnyx_sms",
    "if_sms_fails": "pause_and_notify_human",
    "never": [
      "retry_captcha_automatically"
    ]
  }
}